{
  "name": "@isilin/react-slot",
  "version": "1.0.0",
  "description": "Simple and powerful typed slots for React components",
  "author": "Isilin <isilinbn@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Isilin/react-slot"
  },
  "homepage": "https://github.com/Isilin/react-slot#readme",
  "bugs": {
    "url": "https://github.com/Isilin/react-slot/issues"
  },
  "keywords": [
    "react",
    "slots",
    "slot-components",
    "compound-components",
    "react-slot",
    "typescript",
    "storybook",
    "component-library"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.cjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "sideEffects": false,
  "scripts": {
    "lib:build": "tsup --config tsup.config.ts",
    "lib:dev": "tsup --config tsup.config.ts --watch",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:build": "storybook build --output-dir storybook-static",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:ci": "eslint . --ext .ts,.tsx --format json --output-file eslint_report.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck:ci": "tsc --project tsconfig.json --noEmit > typescript.log"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "change-case": "^5.4.4",
    "react-is": "^18.2.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/react": "^8.6.12",
    "@storybook/react-vite": "^8.6.12",
    "@types/gh-pages": "^6.1.0",
    "@types/node": "^22.15.18",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitejs/plugin-react": "^4.3.4",
    "classnames": "^2.5.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-storybook": "^0.12.0",
    "gh-pages": "^6.3.0",
    "globals": "^16.1.0",
    "prettier": "^3.5.3",
    "storybook": "^8.6.12",
    "tsup": "^8.0.0",
    "typescript": "~5.7.3",
    "vite": "^6.2.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "engines": {
    "node": ">=20",
    "yarn": ">=4"
  }
}
